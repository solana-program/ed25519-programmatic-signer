{
  "kind": "rootNode",
  "standard": "codama",
  "version": "1.9.2",
  "program": {
    "kind": "programNode",
    "name": "ed25519Signer",
    "publicKey": "EdSigVfK1DkeMrjFNDMjwfQaJPhPTtX7jW8uPv3oKEgN",
    "version": "0.1.0",
    "instructions": [
      {
        "kind": "instructionNode",
        "name": "submit",
        "optionalAccountStrategy": "programId",
        "arguments": [
          {
            "kind": "instructionArgumentNode",
            "name": "discriminator",
            "defaultValueStrategy": "omitted",
            "type": {
              "kind": "numberTypeNode",
              "format": "u8",
              "endian": "le"
            },
            "defaultValue": {
              "kind": "numberValueNode",
              "number": 0
            },
            "display": {
              "kind": "structFieldDisplayNode",
              "skip": "always"
            }
          },
          {
            "kind": "instructionArgumentNode",
            "name": "signatures",
            "type": {
              "kind": "arrayTypeNode",
              "item": {
                "kind": "optionTypeNode",
                "fixed": false,
                "item": {
                  "kind": "fixedSizeTypeNode",
                  "size": 64,
                  "type": {
                    "kind": "bytesTypeNode"
                  }
                },
                "prefix": {
                  "kind": "numberTypeNode",
                  "format": "u8",
                  "endian": "le"
                }
              },
              "count": {
                "kind": "prefixedCountNode",
                "prefix": {
                  "kind": "numberTypeNode",
                  "format": "u8",
                  "endian": "le"
                }
              }
            },
            "display": {
              "kind": "structFieldDisplayNode",
              "label": "Authority signatures"
            }
          },
          {
            "kind": "instructionArgumentNode",
            "name": "message",
            "type": {
              "kind": "bytesTypeNode"
            },
            "display": {
              "kind": "structFieldDisplayNode",
              "label": "Authorization message"
            }
          }
        ],
        "discriminators": [
          {
            "kind": "fieldDiscriminatorNode",
            "name": "discriminator",
            "offset": 0
          }
        ],
        "display": {
          "kind": "instructionDisplayNode",
          "intent": "Verify authorization message and invoke its executor"
        },
        "remainingAccounts": [
          {
            "kind": "instructionRemainingAccountsNode",
            "isOptional": false,
            "isSigner": false,
            "docs": [
              "One account for each key in the authorization message's static account-key list, in the same order."
            ],
            "value": {
              "kind": "resolverValueNode",
              "name": "resolveAuthorizationMessageAccounts",
              "docs": [
                "Preserves each authorization message account's writable role without marking it as a relay transaction signer."
              ],
              "dependsOn": [
                {
                  "kind": "argumentValueNode",
                  "name": "message"
                }
              ]
            },
            "display": {
              "kind": "instructionAccountDisplayNode",
              "label": "Authorization message accounts"
            }
          }
        ]
      }
    ],
    "pdas": [
      {
        "kind": "pdaNode",
        "name": "programmaticSigner",
        "seeds": [
          {
            "kind": "constantPdaSeedNode",
            "type": {
              "kind": "stringTypeNode",
              "encoding": "utf8"
            },
            "value": {
              "kind": "stringValueNode",
              "string": "programmatic-signer"
            }
          },
          {
            "kind": "variablePdaSeedNode",
            "name": "authority",
            "type": {
              "kind": "publicKeyTypeNode"
            }
          }
        ]
      }
    ],
    "errors": [
      {
        "kind": "errorNode",
        "name": "invalidMessage",
        "code": 0,
        "message": "The authorization message failed sanitization"
      },
      {
        "kind": "errorNode",
        "name": "invalidExecutorInstructionCount",
        "code": 1,
        "message": "The authorization message must contain exactly one executor instruction"
      },
      {
        "kind": "errorNode",
        "name": "accountKeyMismatch",
        "code": 2,
        "message": "A Submit account differs from the authorization message key at the same index"
      },
      {
        "kind": "errorNode",
        "name": "invalidSignature",
        "code": 3,
        "message": "An authority signature failed verification against the authorization message"
      },
      {
        "kind": "errorNode",
        "name": "disallowedExecutorInstruction",
        "code": 4,
        "message": "The executor program and instruction pair is not permitted by this signer program"
      },
      {
        "kind": "errorNode",
        "name": "invalidSignatureCount",
        "code": 5,
        "message": "The authority signature count does not match the authorization message."
      },
      {
        "kind": "errorNode",
        "name": "unsupportedMessageVersion",
        "code": 6,
        "message": "The authorization message is not a v1 message"
      },
      {
        "kind": "errorNode",
        "name": "unsupportedTransactionConfig",
        "code": 7,
        "message": "The authorization message sets transaction config fields"
      },
      {
        "kind": "errorNode",
        "name": "missingSignature",
        "code": 8,
        "message": "A signer required by the authorization message has no signature and does not sign the relay transaction"
      }
    ]
  },
  "additionalPrograms": []
}