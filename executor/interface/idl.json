{
  "kind": "rootNode",
  "standard": "codama",
  "version": "1.8.0",
  "program": {
    "kind": "programNode",
    "name": "messageExecutor",
    "publicKey": "ExecxgyHYsAXB4c5dZodV1zJZ9hqfsDCYkRDRATrpkFR",
    "version": "0.1.0",
    "instructions": [
      {
        "kind": "instructionNode",
        "name": "execute",
        "accounts": [
          {
            "kind": "instructionAccountNode",
            "name": "nonceAccount",
            "isWritable": true,
            "isSigner": false,
            "docs": [
              "Nonce account consumed for replay protection"
            ]
          },
          {
            "kind": "instructionAccountNode",
            "name": "nonceProgram",
            "isWritable": false,
            "isSigner": false,
            "docs": [
              "SPL Nonce program"
            ],
            "defaultValue": {
              "kind": "publicKeyValueNode",
              "publicKey": "Noncediea1fH12usShuQAz28UhgAeuE5Maf32LsMUQB"
            },
            "display": {
              "kind": "instructionAccountDisplayNode",
              "skip": "always"
            }
          },
          {
            "kind": "instructionAccountNode",
            "name": "slotHashes",
            "isWritable": false,
            "isSigner": false,
            "docs": [
              "Slot Hashes sysvar"
            ],
            "defaultValue": {
              "kind": "publicKeyValueNode",
              "publicKey": "SysvarS1otHashes111111111111111111111111111"
            },
            "display": {
              "kind": "instructionAccountDisplayNode",
              "skip": "always"
            }
          }
        ],
        "arguments": [
          {
            "kind": "instructionArgumentNode",
            "name": "discriminator",
            "defaultValueStrategy": "omitted",
            "type": {
              "kind": "numberTypeNode",
              "format": "u8",
              "endian": "le"
            },
            "defaultValue": {
              "kind": "numberValueNode",
              "number": 0
            },
            "display": {
              "kind": "structFieldDisplayNode",
              "skip": "always"
            }
          },
          {
            "kind": "instructionArgumentNode",
            "name": "message",
            "type": {
              "kind": "bytesTypeNode"
            }
          }
        ],
        "discriminators": [
          {
            "kind": "fieldDiscriminatorNode",
            "name": "discriminator",
            "offset": 0
          }
        ],
        "display": {
          "kind": "instructionDisplayNode",
          "intent": "Execute message"
        },
        "remainingAccounts": [
          {
            "kind": "instructionRemainingAccountsNode",
            "isOptional": false,
            "isSigner": "either",
            "docs": [
              "One account for each key in the wrapped message's static account-key list, in the same order."
            ],
            "value": {
              "kind": "resolverValueNode",
              "name": "resolveMessageAccounts",
              "docs": [
                "Preserves each wrapped message account's signer and writable role."
              ],
              "dependsOn": [
                {
                  "kind": "argumentValueNode",
                  "name": "message"
                }
              ]
            }
          }
        ]
      }
    ],
    "errors": [
      {
        "kind": "errorNode",
        "name": "invalidNonceAccount",
        "code": 0,
        "message": "The nonce account data could not be decoded as nonce state"
      },
      {
        "kind": "errorNode",
        "name": "invalidMessage",
        "code": 1,
        "message": "The message is unsupported, fails sanitization, or has duplicate keys"
      },
      {
        "kind": "errorNode",
        "name": "messageAccountsMismatch",
        "code": 2,
        "message": "The passed accounts do not match the wrapped message's account keys"
      },
      {
        "kind": "errorNode",
        "name": "missingNonceAuthoritySigner",
        "code": 3,
        "message": "The nonce account's stored authority is not a required message signer"
      },
      {
        "kind": "errorNode",
        "name": "nonceMismatch",
        "code": 4,
        "message": "The message's lifetime specifier does not match the stored nonce"
      }
    ]
  }
}