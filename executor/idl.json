{
  "kind": "rootNode",
  "standard": "codama",
  "version": "1.9.2",
  "program": {
    "kind": "programNode",
    "name": "messageExecutor",
    "publicKey": "ExecxgyHYsAXB4c5dZodV1zJZ9hqfsDCYkRDRATrpkFR",
    "version": "1.0.0",
    "instructions": [
      {
        "kind": "instructionNode",
        "name": "execute",
        "optionalAccountStrategy": "programId",
        "accounts": [
          {
            "kind": "instructionAccountNode",
            "name": "nonceAuthority",
            "isWritable": false,
            "isSigner": true,
            "isOptional": false,
            "docs": [
              "Authority signer for the nonce account"
            ],
            "display": {
              "kind": "instructionAccountDisplayNode",
              "label": "Nonce authority"
            }
          },
          {
            "kind": "instructionAccountNode",
            "name": "nonceAccount",
            "isWritable": true,
            "isSigner": false,
            "isOptional": false,
            "docs": [
              "Nonce account consumed for replay protection"
            ],
            "display": {
              "kind": "instructionAccountDisplayNode",
              "label": "Nonce account to advance"
            }
          },
          {
            "kind": "instructionAccountNode",
            "name": "nonceProgram",
            "isWritable": false,
            "isSigner": false,
            "isOptional": false,
            "docs": [
              "SPL Nonce program"
            ],
            "defaultValue": {
              "kind": "publicKeyValueNode",
              "publicKey": "Noncediea1fH12usShuQAz28UhgAeuE5Maf32LsMUQB"
            },
            "display": {
              "kind": "instructionAccountDisplayNode",
              "skip": "always"
            }
          },
          {
            "kind": "instructionAccountNode",
            "name": "transitionSigner",
            "isWritable": false,
            "isSigner": false,
            "isOptional": false,
            "docs": [
              "Executor transition signer"
            ],
            "defaultValue": {
              "kind": "publicKeyValueNode",
              "publicKey": "EjCSGNbrrM7YJBwR9iqnrb87L1TYHfUtZ5L4gwQjWLFg"
            },
            "display": {
              "kind": "instructionAccountDisplayNode",
              "skip": "always"
            }
          }
        ],
        "arguments": [
          {
            "kind": "instructionArgumentNode",
            "name": "discriminator",
            "defaultValueStrategy": "omitted",
            "type": {
              "kind": "numberTypeNode",
              "format": "u8",
              "endian": "le"
            },
            "defaultValue": {
              "kind": "numberValueNode",
              "number": 0
            },
            "display": {
              "kind": "structFieldDisplayNode",
              "skip": "always"
            }
          },
          {
            "kind": "instructionArgumentNode",
            "name": "message",
            "type": {
              "kind": "bytesTypeNode"
            },
            "display": {
              "kind": "structFieldDisplayNode",
              "label": "Execution message"
            }
          }
        ],
        "discriminators": [
          {
            "kind": "fieldDiscriminatorNode",
            "name": "discriminator",
            "offset": 0
          }
        ],
        "display": {
          "kind": "instructionDisplayNode",
          "intent": "Execute all instructions in an execution message"
        },
        "remainingAccounts": [
          {
            "kind": "instructionRemainingAccountsNode",
            "isOptional": false,
            "isSigner": "either",
            "docs": [
              "One account for each key in the execution message's static account-key list, in the same order."
            ],
            "value": {
              "kind": "resolverValueNode",
              "name": "resolveExecutionMessageAccounts",
              "docs": [
                "Preserves each execution message account's signer and writable role."
              ],
              "dependsOn": [
                {
                  "kind": "argumentValueNode",
                  "name": "message"
                }
              ]
            },
            "display": {
              "kind": "instructionAccountDisplayNode",
              "label": "Execution message accounts"
            }
          }
        ]
      }
    ],
    "pdas": [
      {
        "kind": "pdaNode",
        "name": "transitionSigner",
        "seeds": [
          {
            "kind": "constantPdaSeedNode",
            "type": {
              "kind": "stringTypeNode",
              "encoding": "utf8"
            },
            "value": {
              "kind": "stringValueNode",
              "string": "transition-signer"
            }
          }
        ]
      }
    ],
    "errors": [
      {
        "kind": "errorNode",
        "name": "invalidNonceAccount",
        "code": 0,
        "message": "The nonce account data could not be decoded as nonce state"
      },
      {
        "kind": "errorNode",
        "name": "invalidMessage",
        "code": 1,
        "message": "The v1 message fails sanitization or contains duplicate keys"
      },
      {
        "kind": "errorNode",
        "name": "messageAccountsMismatch",
        "code": 2,
        "message": "The passed accounts do not match the execution message's account keys"
      },
      {
        "kind": "errorNode",
        "name": "nonceMismatch",
        "code": 3,
        "message": "The message's recent blockhash does not match the stored nonce"
      },
      {
        "kind": "errorNode",
        "name": "unsupportedMessageVersion",
        "code": 4,
        "message": "The execution message is not a v1 message"
      },
      {
        "kind": "errorNode",
        "name": "unsupportedTransactionConfig",
        "code": 5,
        "message": "The execution message sets transaction config fields"
      },
      {
        "kind": "errorNode",
        "name": "invalidTransitionSigner",
        "code": 6,
        "message": "The transition signer is not the Executor PDA for this nonce account"
      }
    ]
  },
  "additionalPrograms": []
}